PORT=3000
NODE_ENV=development

DEFAULT_PROVIDER=polymarket

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=polymarket_trader
DATABASE_SSL=false
PGSSLMODE=
PGCHANNELBINDING=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TLS=false

POLYMARKET_CLOB_API_URL=https://clob.polymarket.com
POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com

POLYMARKET_ENABLE_REAL_TRADING=false
#Note: You can get this from the polymarket dashboard from the profile section
POLYMARKET_WALLET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=1
POLYMARKET_CHAIN_ID=137

SYNC_CRON_EXPRESSION=*/15 * * * *
PRICE_UPDATE_CRON_EXPRESSION=*/5 * * * *
POLYMARKET_RPC_URL=

#Usdc token address on the polygon network
POLYMARKET_USDC_ADDRESS=

# Optional: provide Polymarket CLOB API key creds directly (otherwise derived from wallet)
POLYMARKET_CLOB_API_KEY=
POLYMARKET_CLOB_API_SECRET=
POLYMARKET_CLOB_API_PASSPHRASE=

# Celo (reserve + ERC-8004)
CELO_RPC_URL=
CELO_SERVER_PRIVATE_KEY=
CELO_CUSD_TOKEN_ADDRESS=
CELO_RESERVE_ADDRESS=
CELO_ERC8004_REGISTRY_ADDRESS=
